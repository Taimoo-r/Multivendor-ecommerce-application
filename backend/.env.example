NODE_ENV=development
PORT=8000
# Where the frontend is served from. Used for CORS and for links in emails.
FRONTEND_URL=http://localhost:5173

DB_URL=
# Set if your resolver refuses Atlas SRV lookups (querySrv ECONNREFUSED)
# DNS_SERVERS=1.1.1.1,8.8.8.8

JWT_SECRET_KEY=
ACTIVATION_SECRET=
ACTIVATION_EXPIRES=5m

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Gmail: use an app password, not your account password
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_MAIL=
SMTP_PASSWORD=

# Cache, rate limits and session revocation. Optional: without it the app falls back to
# per-process memory (fine for one instance, not for several).
REDIS_URL=redis://localhost:6379
